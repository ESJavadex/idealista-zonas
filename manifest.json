{
  "manifest_version": 3,
  "name": "Idealista Zonas · ¿comprar aquí?",
  "version": "2.2.0",
  "description": "Para buscar casa en idealista sin conocer la ciudad: tus zonas y capas en el mapa (DANA 2024, PATRICOVA, renta, pisos turísticos), precio real e hipoteca, nota de 0 a 10 de cada vivienda (inundación, criminalidad oficial, renta, servicios, coche, precio, Catastro…) en fichas y listados con filtros y orden, ajustes de pesos y comparador exportable.",
  "content_scripts": [
    {
      "matches": [
        "*://www.idealista.com/*",
        "*://idealista.com/*",
        "*://*.idealista.com/*"
      ],
      "js": [
        "zonas.js",
        "hook.js",
        "capas.js",
        "precio-final.js",
        "seguridad.js",
        "catastro.js",
        "barrio.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://www.idealista.com/*",
        "*://idealista.com/*",
        "*://*.idealista.com/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "servicios/*.json",
        "criminalidad/*.json"
      ],
      "matches": [
        "*://*.idealista.com/*"
      ]
    }
  ]
}
