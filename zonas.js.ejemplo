// =========================================================================
// zonas.js — PLANTILLA. Cópiala a "zonas.js" y rellénala:
//
//     cp zonas.js.ejemplo zonas.js
//
// ...o genera los datos automáticamente (barrios + municipios reales):
//     cd herramientas && python3 generar_zonas.py
//     (ver README.md)
//
//   veredicto: "bien" | "regular" | "mal" | "muy_mal" | "duda"
//   tipo "punto":    lat, lng + radio_km (círculo)  <- lo más fácil
//   tipo "poligono": puntos = [[lat, lng], ...]     <- contorno exacto
//
// Coordenadas: clic derecho en Google Maps → "copiar coordenadas".
// =========================================================================

(function () {
  "use strict";

  // Escala: bien -> regular -> mal -> muy_mal; duda (gris) = sin evidencia
  window.IDEALISTA_ZONAS_COLORES = {
    bien:     { relleno: "#16a34a", borde: "#166534" },  // verde
    regular:  { relleno: "#f59e0b", borde: "#b45309" },  // naranja
    mal:      { relleno: "#dc2626", borde: "#991b1b" },  // rojo
    muy_mal:  { relleno: "#7f1d1d", borde: "#450a0a" },  // granate
    duda:     { relleno: "#9ca3af", borde: "#6b7280" }   // gris
  };

  // claves = trozos de URL de idealista en los que se pintan estas zonas.
  // En URLs que no casen con ninguna clave (p. ej. /point/lat/lng/zoom/…)
  // la extensión pinta TODAS las zonas, para estar siempre activa.
  window.IDEALISTA_ZONAS = [
    {
      claves: ["mi-provincia"],
      zonas: [
        { nombre: "Barrio de ejemplo", veredicto: "bien", tipo: "punto", lat: 40.4168, lng: -3.7038, radio_km: 1.0 },
        { nombre: "Zona a evitar",     veredicto: "mal",  tipo: "punto", lat: 40.4250, lng: -3.6900, radio_km: 1.5 },
        { nombre: "Sin datos",         veredicto: "duda", tipo: "punto", lat: 40.4300, lng: -3.7100, radio_km: 1.2 }
      ]
    }
    // ^ añade más grupos (uno por provincia) según necesites
  ];
})();